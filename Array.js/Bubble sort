
let arr = [3,1,4,5];
let it =0;
for(let i=0;i<arr.length-1;i++)
{
  let isswap = false;

  for(let j=0;j<arr.length - i - 1;j++)

  {
    
    if(arr[j]>arr[j+1])
    {
      let temp = arr[j+1];
      arr[j+1]=arr[j];
      arr[j]=temp;
      isswap=true;
     
    }
     it++;
  }
  if(!isswap) break;
}
console.log(arr,it);
